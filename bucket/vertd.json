{
    "version": "2026.10.04.e50ad61",
    "description": "VERT's solution to crappy video conversion services.",
    "homepage": "https://github.com/VERT-sh/vertd",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/VERT-sh/vertd/releases/download/nightly-e50ad616c122b4f2bac7ea813677b56f4670fb06/vertd-windows-x86_64.exe#/vertd.exe",
            "hash": "1a2c41dfdbb287571706c9f0bf32414be6bbd51e6f152ec6c304f7f86e2f35ce"
        }
    },
    "bin": "vertd.exe",
    "checkver": {
        "script": [
            "$h = $(if ($tok = Get-GitHubToken) { @{ Authorization = \"token $tok\" } } else { @{} })",
            "$release = Invoke-RestMethod 'https://api.github.com/repos/VERT-sh/vertd/releases/latest' -Headers $h",
            "$tag = $release.tag_name",
            "$date = $release.published_at.ToString('yyyy.MM.dd')",
            "$sha = ($tag -replace 'nightly-', '').Substring(0,7)",
            "Write-Output \"$date.$sha|$tag\""
        ],
        "regex": "^(?<version>\\d{4}\\.\\d{2}\\.\\d{2}\\.[a-f0-9]{7})\\|(?<tag>.+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/VERT-sh/vertd/releases/download/$matchTag/vertd-windows-x86_64.exe#/vertd.exe"
            }
        }
    }
}
