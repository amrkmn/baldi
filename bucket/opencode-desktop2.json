{
    "version": "2.3.0",
    "description": "The open source AI coding agent desktop application. (v2)",
    "homepage": "https://opencode.ai/v2",
    "license": "MIT",
    "notes": [
        "The v2 configuration is incompatible with v1.",
        "See https://opencode.ai/v2/docs/migrate-v1/ for migration steps."
    ],
    "architecture": {
        "64bit": {
            "url": "https://opencode.ai/files/bin/2.3.0/opencode-desktop-win-x64.exe#/dl.7z",
            "hash": "21e4d45dd957ebe92d3ea693fc4a7f7bb5b50276046bf7b78767081dd37d685e"
        },
        "arm64": {
            "url": "https://opencode.ai/files/bin/2.3.0/opencode-desktop-win-arm64.exe#/dl.7z",
            "hash": "163a82e75405a5c2117e958a744b71c963dfab1358047fed3240363d62f4efbe"
        }
    },
    "pre_install": [
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-*.7z\" \"$dir\"",
        "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Force -Recurse -ErrorAction Ignore"
    ],
    "shortcuts": [
        [
            "OpenCode.exe",
            "OpenCode 2"
        ]
    ],
    "checkver": {
        "url": "https://opencode.ai/update/api/latest/desktop/opencode",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://opencode.ai/files/bin/$version/opencode-desktop-win-x64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://opencode.ai/files/bin/$version/opencode-desktop-win-arm64.exe#/dl.7z"
            }
        },
        "hash": {
            "mode": "json",
            "url": "https://opencode.ai/update/api/latest/desktop/opencode",
            "jsonpath": "$.metadata.files['$basename'].sha256"
        }
    }
}
