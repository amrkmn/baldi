    "license": "Apache-2.0",
    "url": "https://registry.npmjs.org/@qwen-code/qwen-code/-/qwen-code-0.23.4.tgz",
    "hash": "sha512:aab33b2f0a7d4ba2df231f0c87db00af86813f251af56d24ef6b8e4093ec27a67c0a5033a0443391d2c3d53adc862a0989c8127243353cbc9e9dd89bc971c494",
    "extract_dir": "package",
    "depends": "main/nodejs",
    "bin": [
