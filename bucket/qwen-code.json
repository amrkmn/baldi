    "license": "Apache-2.0",
    "url": "https://registry.npmjs.org/@qwen-code/qwen-code/-/qwen-code-0.21.5.tgz",
    "hash": "sha512:9b770a4fc8be6dc123b7359622682fe2845e31232ec4f79cbe8286920e5c892e3194a1ae24e1cd011380ebc0e2e664b030ea2b002a938dbf23255690bacb9d86",
    "extract_dir": "package",
    "depends": "main/nodejs",
    "bin": [
