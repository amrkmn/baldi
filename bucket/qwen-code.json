{
    "version": "0.21.4",
    "description": "Qwen Code is a coding agent that lives in digital world",
    "homepage": "https://github.com/QwenLM/qwen-code",
    "license": "Apache-2.0",
    "url": "https://registry.npmjs.org/@qwen-code/qwen-code/-/qwen-code-0.21.4.tgz",
    "hash": "sha512:bd9e6338e546f587afd282b1044b1cca7b606687c7b95a976c1ada58576cddb57f46ed5da501a6c0d1493f47debe84794cb39635b88ebf60cf2f3def84d774c9",
    "extract_dir": "package",
    "depends": "main/nodejs",
    "bin": [
        [
            "node",
            "qwen",
            "$dir\\cli.js"
        ]
    ],
    "post_install": [
        "Push-Location $dir",
        "npm install --omit=dev --silent",
        "Pop-Location"
