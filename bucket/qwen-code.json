    "license": "Apache-2.0",
    "url": "https://registry.npmjs.org/@qwen-code/qwen-code/-/qwen-code-0.21.7.tgz",
    "hash": "sha512:5b6c7c36680c94fa4cad9d687518040e21c7fdb724ad7b6bc82cf52a7b6dc2c78332938b55368cf0fba8d545b977136fe5d6af761511ba96fab9576a29523ba2",
    "extract_dir": "package",
    "depends": "main/nodejs",
    "bin": [
