    "license": "Apache-2.0",
    "url": "https://registry.npmjs.org/@qwen-code/qwen-code/-/qwen-code-0.21.3.tgz",
    "hash": "sha512:02bf44e552df8f9652622d6a00bfbf1eb8ea78b4b3172d8c3732f4b02b209a791cf1f3a3dce95b0a5507bf9655146eb33bca7f9f1d8e111ab463b3b1d87d4802",
    "extract_dir": "package",
    "depends": "main/nodejs",
    "bin": [
