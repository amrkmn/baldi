    "license": "Apache-2.0",
    "url": "https://registry.npmjs.org/@qwen-code/qwen-code/-/qwen-code-0.21.13.tgz",
    "hash": "sha512:c57c8e2b5eba1047938c7521f4111d1f887b01f873e7793e8c902fe66805c506096c77f6e68c627fa59193a8ef606c0cc6911d2f7bdaa1444ffd0422a6537d95",
    "extract_dir": "package",
    "depends": "main/nodejs",
    "bin": [
        [
            "node",
            "qwen",
            "$dir\\cli.js"
        ]
    ],
    "post_install": [
        "Push-Location $dir",
        "npm install --omit=dev --silent",
        "Pop-Location"
