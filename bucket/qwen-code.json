    "license": "Apache-2.0",
    "url": "https://registry.npmjs.org/@qwen-code/qwen-code/-/qwen-code-0.21.6.tgz",
    "hash": "sha512:b00e5d71d1f4de29551f965efe8444247b9495817d6f67e7dabb9c596aa7bc2e50ee2fedf62634ad245edf651766ab8f16ea3d5760d50e874439416a0a1cfd90",
    "extract_dir": "package",
    "depends": "main/nodejs",
    "bin": [
