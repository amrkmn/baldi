    "license": "Apache-2.0",
    "url": "https://registry.npmjs.org/@qwen-code/qwen-code/-/qwen-code-0.23.2.tgz",
    "hash": "sha512:3ad8646989f345ab95a2993dca181b4147dbb10a3f078e5f07beb21e8f3ade0462bf6729f0d9833acd7eefd2b13dbd33a22fc6ddf0ba3af507560a9d08270525",
    "extract_dir": "package",
    "depends": "main/nodejs",
    "bin": [
