{
    "version": "0.27.3",
    "description": "Qwen Code is a coding agent that lives in digital world",
    "homepage": "https://github.com/QwenLM/qwen-code",
    "license": "Apache-2.0",
    "url": "https://registry.npmjs.org/@qwen-code/qwen-code/-/qwen-code-0.27.3.tgz",
    "hash": "sha512:86bf2a19aee9e6c6e13f41e3af2362982be438574ee7e157cd971428f0d5b767becb67e8873c8438b017cce03a1720f5af8593220aa493299987d5bffd42fdbe",
    "extract_dir": "package",
    "depends": "main/nodejs",
    "bin": [
        [
            "node",
            "qwen",
            "$dir\\cli.js"
        ]
    ],
    "post_install": [
        "Push-Location $dir",
        "npm install --omit=dev --silent",
        "Pop-Location"
    ],
    "checkver": {
        "url": "https://registry.npmjs.org/@qwen-code/qwen-code/latest",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "url": "https://registry.npmjs.org/@qwen-code/qwen-code/-/qwen-code-$version.tgz",
        "hash": {
            "url": "https://registry.npmjs.org/@qwen-code/qwen-code/$version",
            "regex": "sha512-([A-Za-z0-9+/=]+)"
        }
    }
}
