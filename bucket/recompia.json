{
    "version": "0.17.5",
    "description": "Cozy life-simulation and sandbox builder with fantastical creatures, recompiled to run natively",
    "homepage": "https://www.recompia.com",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Dittobyte/Recompia/releases/download/v0.17.5/Recompia-0.17.5-windows-x64.zip",
            "hash": "3011a0328779ff643657cdb09eef44ce295bf29c54fc546303920e0045c52779",
            "extract_dir": "Recompia-0.17.5"
        }
    },
    "pre_install": [
        "'controls.ini', 'pkp.ini' | ForEach-Object {",
        "    if (!(Test-Path \"$persist_dir\\$_\")) {",
        "        New-Item -Path \"$dir\\$_\" -ItemType File -Force | Out-Null",
        "    }",
        "}"
    ],
    "shortcuts": [
        [
            "Recompia.exe",
            "Recompia"
        ]
    ],
    "persist": [
        "save",
        "shader_cache",
        "nup_dump",
        "pokohex_data",
        "controls.ini",
        "pkp.ini"
    ],
    "checkver": {
        "github": "https://github.com/Dittobyte/Recompia"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Dittobyte/Recompia/releases/download/v$version/Recompia-$version-windows-x64.zip",
                "extract_dir": "Recompia-$version"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
