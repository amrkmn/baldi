{
    "version": "2026.10.05.64f574f",
    "description": "CLI uploader for Copyparty servers",
    "homepage": "https://github.com/9001/copyparty",
    "license": "MIT",
    "depends": "python",
    "url": "https://raw.githubusercontent.com/9001/copyparty/64f574fe94d5138544b34bb899324a7aa8405e2c/bin/u2c.py",
    "hash": "1bafa1963bae6f1613462cf6c0237e718a0f031f9ff59985324d4e944911bc24",
    "bin": [
        [
            "python",
            "u2c",
            "$dir\\u2c.py"
        ]
    ],
    "checkver": {
        "script": [
            "$h = $(if ($tok = Get-GitHubToken) { @{ Authorization = \"token $tok\" } } else { @{} })",
            "$c = (Invoke-RestMethod 'https://api.github.com/repos/9001/copyparty/commits?path=bin/u2c.py&per_page=1' -Headers $h)[0]",
            "$date = $c.commit.author.date.ToString('yyyy.MM.dd')",
            "$sha = $c.sha.Substring(0,7)",
            "Write-Output \"$date.$sha|$($c.sha)\""
        ],
        "regex": "^(?<version>\\d{4}\\.\\d{2}\\.\\d{2}\\.[a-f0-9]{7})\\|(?<commit>[a-f0-9]+)$"
    },
    "autoupdate": {
        "url": "https://raw.githubusercontent.com/9001/copyparty/$matchCommit/bin/u2c.py"
    }
}
