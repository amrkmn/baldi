{
    "version": "0.57.0",
    "description": "An open-source AI agent that brings the power of Gemini directly into your terminal",
    "homepage": "https://google-gemini.github.io/gemini-cli/",
    "license": "Apache-2.0",
    "url": "https://registry.npmjs.org/@google/gemini-cli/-/gemini-cli-0.57.0.tgz",
    "hash": "sha512:234574dddde4d09d193769bdbb9e1784ddd570c1be563c8fce8cbb13d415f25873777f42e9481a6462d936c3a03833ad0e12bc60c8a31c95899fe431a29dae9b",
    "extract_dir": "package",
    "depends": "main/nodejs",
    "bin": [
        [
            "node",
            "gemini",
            "$dir\\bundle\\gemini.js"
        ]
    ],
    "post_install": [
        "Push-Location $dir",
        "npm install --omit=dev --silent",
        "Pop-Location"
    ],
    "checkver": {
        "url": "https://registry.npmjs.org/@google/gemini-cli/latest",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "url": "https://registry.npmjs.org/@google/gemini-cli/-/gemini-cli-$version.tgz",
        "hash": {
            "url": "https://registry.npmjs.org/@google/gemini-cli/$version",
            "regex": "sha512-([A-Za-z0-9+/=]+)"
        }
    }
}
